#include "nv3041a_i80.hpp"
#include "esphome/core/log.h"

namespace esphome {
namespace nv3041a_i80 {

static const char *const TAG = "nv3041a_final_8bit";

// Fonction miroir pour inverser l'ordre des bits (D0 <-> D7)
uint8_t reflect_bits(uint8_t b) {
  b = (b & 0xF0) >> 4 | (b & 0x0F) << 4;
  b = (b & 0xCC) >> 2 | (b & 0x33) << 2;
  b = (b & 0xAA) >> 1 | (b & 0x55) << 1;
  return b;
}

void NV3041ADisplay::setup() {
  ESP_LOGI(TAG, "--- DEMARRAGE DU TEST INTERVERSION 8-BITS ---");

  // 1. Reset matériel strict (GPIO 38)
  const gpio_num_t LCD_RESET_PIN = GPIO_NUM_38;
  gpio_config_t rst_cfg = {
    .pin_bit_mask = (1ULL << LCD_RESET_PIN),
    .mode = GPIO_MODE_OUTPUT,
    .pull_up_en = GPIO_PULLUP_DISABLE,
    .pull_down_en = GPIO_PULLDOWN_DISABLE,
    .intr_type = GPIO_INTR_DISABLE
  };
  gpio_config(&rst_cfg);

  gpio_set_level(LCD_RESET_PIN, 1); delay(10);
  gpio_set_level(LCD_RESET_PIN, 0); delay(50);
  gpio_set_level(LCD_RESET_PIN, 1); delay(250);

  // 2. Configuration du bus (Ordre inversé qui supprimait la neige)
  esp_lcd_i80_bus_config_t bus_config = {
    .dc_gpio_num = 47,    // LCD_RS
    .wr_gpio_num = 21,    // LCD_WR
    .clk_src = LCD_CLK_SRC_DEFAULT,
    .data_gpio_nums = {10, 11, 12, 13, 14, 41, 40, 39}, // Ordre miroir
    .bus_width = 8,
    .max_transfer_bytes = 4096,
  };
  ESP_ERROR_CHECK(esp_lcd_new_i80_bus(&bus_config, &this->io_bus_));

  esp_lcd_panel_io_i80_config_t io_config = {
    .cs_gpio_num = 1,
    .pclk_hz = 4 * 1000 * 1000,    // 4 MHz
    .trans_queue_depth = 1,
    .lcd_cmd_bits = 8,
    .lcd_param_bits = 8,
  };
  ESP_ERROR_CHECK(esp_lcd_new_panel_io_i80(this->io_bus_, &io_config, &this->panel_io_));

  // 3. Séquence minimale de réveil MIPI standard (Inversion des commandes)
  // Sortie de veille (0x11) -> Miroir = 0x11
  esp_lcd_panel_io_tx_param(this->panel_io_, 0x11, NULL, 0);
  delay(150);

  // Format de pixel (0x3A) -> Miroir = 0x5C. Paramètre 0x05 -> Miroir = 0xA0
  uint8_t colmod_param[] = { reflect_bits(0x05) };
  esp_lcd_panel_io_tx_param(this->panel_io_, 0x5C, colmod_param, 1);

  // Allumage écran (0x29) -> Miroir = 0x94
  esp_lcd_panel_io_tx_param(this->panel_io_, 0x94, NULL, 0);
  delay(100);

  // 4. Fenêtre de coordonnées sur tout l'écran (720x544)
  // CASET (0x2A) -> Miroir = 0x54
  uint8_t caset_data[] = { reflect_bits(0x00), reflect_bits(0x00), reflect_bits(0x01), reflect_bits(0xDF) };
  esp_lcd_panel_io_tx_param(this->panel_io_, 0x54, caset_data, 4);

  // RASET (0x2B) -> Miroir = 0xD4
  uint8_t raset_data[] = { reflect_bits(0x00), reflect_bits(0x00), reflect_bits(0x01), reflect_bits(0x0F) };
  esp_lcd_panel_io_tx_param(this->panel_io_, 0xD4, raset_data, 4);

  // 5. Inondation manuelle en ROUGE
  ESP_LOGI(TAG, "Remplissage de la matrice...");
  uint8_t red_pixel_bytes[] = { reflect_bits(0xF8), reflect_bits(0x00) };

  // RAMWR (0x2C) -> Miroir = 0x34
  for (uint32_t i = 0; i < (480 * 272); i++) {
    esp_lcd_panel_io_tx_param(this->panel_io_, 0x34, red_pixel_bytes, 2);
    if (i % 1000 == 0) {
      delay(1);
    }
  }

  // 6. Allocation minimale de contournement
  this->buffer_size_ = 32;
  this->buffer_ = (uint8_t *) heap_caps_malloc(this->buffer_size_, MALLOC_CAP_INTERNAL);

  ESP_LOGI(TAG, "--- FIN DE L'INJECTION MANUELLE ---");
}

void NV3041ADisplay::update() {}
void NV3041ADisplay::draw_absolute_pixel_internal(int x, int y, Color color) {}

}  // namespace nv3041a_i80
}  // namespace esphome
